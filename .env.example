# Copy this file to `.env` and replace every CHANGE_ME value with your own password.
# `.env` is git-ignored. Never commit real passwords.

MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
PBE_DB_NAME=pbe

# Account used by the API (INSERT/UPDATE/DELETE/SELECT/EXECUTE only - no DDL)
PBE_DB_USER=pbe_app
PBE_DB_PASSWORD=CHANGE_ME_app_password

# Read-only reporting account (SELECT only)
PBE_READONLY_USER=pbe_readonly
PBE_READONLY_PASSWORD=CHANGE_ME_readonly_password

# Host ports (change if something else already uses them)
PBE_WEB_PORT=8080
PBE_API_PORT=8000
PBE_DB_HOST_PORT=3307

# Allowed browser origins for CORS (comma separated)
PBE_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Load the bundled SYNTHETIC demo data when the API starts (true/false)
PBE_LOAD_DEMO_DATA=true

# --- only used when running the API WITHOUT Docker (see README, option B) ---
# PBE_DB_HOST=127.0.0.1
# PBE_DB_PORT=3306
# PBE_ENGINE_PATH=C:\path\to\engine.exe
